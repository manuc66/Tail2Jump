<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Tail2Jump.App.Views"
        xmlns:infra="using:Tai2JumpInfra"
        x:Class="Tail2Jump.App.Views.MainWindow"
        Title="{Binding Title}"
        Width="1015"
        Height="508"
        MinWidth="640"
        MinHeight="360"
        Background="#FF2D2D30"
        Icon="/Assets/tail.ico"
        DragDrop.AllowDrop="True"
        x:CompileBindings="False">

  <Grid ColumnDefinitions="Auto,*">

    <!-- Watchers panel -->
    <Border Grid.Column="0"
            Width="230"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="0,0,1,0"
            IsVisible="{Binding !IsPanelCollapsed}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="6">
        <StackPanel Grid.Row="0" Margin="4,2,4,6">
          <TextBlock Text="Instances" FontSize="22" Foreground="White" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Watcher started list " FontSize="11" Foreground="#FFB8B7B7" />
            <TextBlock Text="{Binding WatcherCount}" FontSize="11" Foreground="#FF9ACD32" />
          </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="1"
                 Name="WatchersList"
                 ItemsSource="{Binding Watchers}"
                 SelectionMode="Multiple"
                 SelectionChanged="OnWatchersSelectionChanged"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="infra:IMonitoringInstance">
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding TitleName}"
                           ToolTip.Tip="{Binding TitleName}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#FF9ACD32" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="2,6">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <Button Command="{Binding AddWatcherCommand}" ToolTip.Tip="Add a watcher" Padding="8,2">
              <Image Source="/Assets/Images/add.png" Width="16" Height="16" />
            </Button>
            <Button Command="{Binding RemoveWatcherCommand}" ToolTip.Tip="Remove selected watchers" Padding="8,2">
              <Image Source="/Assets/Images/delete.png" Width="16" Height="16" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,0">
            <CheckBox Content="Search" IsChecked="{Binding ShowSearch}" FontSize="12" />
            <CheckBox Content="Console" IsChecked="{Binding ShowConsole}" FontSize="12" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Column="1" ColumnDefinitions="18,*">
      <Button Grid.Column="0"
              Command="{Binding TogglePanelCommand}"
              Background="Transparent"
              BorderThickness="0"
              Padding="0"
              VerticalAlignment="Stretch"
              ToolTip.Tip="Show/hide the watchers panel">
        <TextBlock Text="‹" FontSize="16" Foreground="#FFB8B7B7" />
      </Button>

      <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto,Auto">

        <views:LogTextView Grid.Row="0" Margin="2" />

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="5,0,5,5" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <CheckBox Grid.Column="0"
                    Content="AutoScroll"
                    IsChecked="{Binding AutoScroll}"
                    IsEnabled="{Binding CanAutoScrollToEnd}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0" />
          <CheckBox Grid.Column="1"
                    Content="Blink"
                    IsChecked="{Binding FlashWindow}"
                    IsEnabled="{Binding CanBlink}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0" />
          <ComboBox Grid.Column="2"
                    ItemsSource="{Binding Editors}"
                    SelectedItem="{Binding OpenIn}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    ToolTip.Tip="Editor used when a log line references a file">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" Margin="4,0" MinWidth="70" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
            <Button Content="Start" Command="{Binding StartCommand}" MinWidth="70" Background="#FF1C7848" />
            <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="70" Background="#FF9B2222" />
          </StackPanel>
        </Grid>

        <!-- Search / filter -->
        <Border Grid.Row="2"
                IsVisible="{Binding ShowSearch}"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="6">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Grid.Column="0"
                     Name="SearchBox"
                     Text="{Binding SearchText}"
                     Watermark="Filter the displayed lines…"
                     Margin="0,0,6,0" />
            <CheckBox Grid.Column="1"
                      Content="Highlight"
                      IsChecked="{Binding SearchActivated}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0" />
            <CheckBox Grid.Column="2"
                      Content="Filter"
                      IsChecked="{Binding FilterActivated}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0" />
            <CheckBox Grid.Column="3"
                      Content="Ignore case"
                      IsChecked="{Binding IgnoreCase}"
                      VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Debug console -->
        <Border Grid.Row="3"
                IsVisible="{Binding ShowConsole}"
                Height="150"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0">
          <ListBox ItemsSource="{Binding Logs}"
                   Background="Transparent"
                   BorderThickness="0"
                   FontSize="11">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding DisplayedDatetime}" Foreground="#FF888888" />
                  <TextBlock Text="{Binding Text}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
