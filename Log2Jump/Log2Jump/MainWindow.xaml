<Window x:Class="WpfTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:WpfTest"
        x:Name="haha"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:manuc66="clr-namespace:Be.Manuc66.Library;assembly=Manuc66Library"
        Title="MainWindow" Height="350" Width="525">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <RichTextBox
            SizeChanged="txtBox_SizeChanged"
            Name="txtBox"
            IsDocumentEnabled="True" 
            IsReadOnly="True"
            UndoLimit="0"
            AcceptsReturn="True"
            AcceptsTab="True"                         
            FontStretch="Normal" 
            FontFamily="Lucida Console"           
            FontSize="13"
            PreviewMouseWheel="RichTextBox_PreviewMouseWheel"
            Grid.Column="0"
            Grid.Row="0"
            RenderOptions.CachingHint="Cache"
            RenderOptions.EdgeMode="Unspecified"
            RenderOptions.ClearTypeHint="Auto"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden"        
            IsUndoEnabled="False" 
            SnapsToDevicePixels="True" />
        <ScrollBar 
            Name="scroller" 
            Maximum="{Binding ScrollMaximum}" 
            Scroll="scroller_Scroll" 
            Minimum="0" 
            Grid.Column="1"            
                         Grid.Row="0"
            HorizontalAlignment="Right"
            SmallChange="1"/>
        <ScrollBar Scroll="hscroll_Scroll" Name="hscroll" Grid.Row="1"  SmallChange="1" Orientation="Horizontal" Grid.Column="0"/>
        <ComboBox  Grid.Row="2" Grid.Column="0" SelectedItem="{Binding OpenInVS}" ItemsSource="{Binding VSList}" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock HorizontalAlignment="Right" TextTrimming="None"  Text="{Binding Path=SolutionPath}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InDebug}" Value="True">
                                        <Setter Property="Background" Value="#FF18A203"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</Window>
