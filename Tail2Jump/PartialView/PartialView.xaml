<UserControl x:Class="PartialView.PartialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <RichTextBox 
                Grid.Column="0"
                Grid.Row="0"
                Name="TxtBoxTailContent"
                SizeChanged="txtBox_SizeChanged"
                VerticalContentAlignment="Bottom"
                PreviewMouseWheel="RichTextBox_PreviewMouseWheel"
                IsDocumentEnabled="True" 
                IsReadOnly="True"
                UndoLimit="0"
                AcceptsReturn="True"
                AcceptsTab="True"                         
                FontStretch="Normal"
                FontFamily="Lucida Console"           
                FontSize="13"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden"
                ScrollViewer.ScrollChanged="scrollview_ScrollChanged"
                LayoutUpdated="TxtBoxTailContent_OnLayoutUpdated"
                IsUndoEnabled="False"
                RenderOptions.CachingHint="Cache"
                RenderOptions.EdgeMode="Unspecified"
                RenderOptions.ClearTypeHint="Auto"                
                SnapsToDevicePixels="True"
                OpacityMask="{x:Null}" 
            
                Background="#FF1C1C1C" 
                Foreground="#FFB8B7B7" 
                BorderBrush="{x:Null}" Initialized="TxtBoxTailContent_Initialized">
        </RichTextBox>

        <ScrollBar 
            Name="scroller" 
            Style="{StaticResource SMScrollBarStyle}"
            Maximum="{Binding ScrollMaximum}" 
            Scroll="scroller_Scroll" 
            Minimum="0"           
            Grid.Row="0"
            Grid.Column="1"  
            Width="16"
            HorizontalAlignment="Right"
            SmallChange="1"/>
        <ScrollBar Grid.Row="1" Grid.Column="0"  Style="{StaticResource SMScrollBarStyle}" Scroll="hscroll_Scroll" Name="hscroll" Height="16" SmallChange="1" Orientation="Horizontal" />
        <TextBlock        
            Grid.Row="1"
            Grid.Column="1"  ></TextBlock>
    </Grid>
</UserControl>
