<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml"></ResourceDictionary>
  </ResourceDictionary.MergedDictionaries>

  <!--TextBox (a finir)-->
  <Style x:Key="SMTextBoxStyle" TargetType="TextBox">
    <Setter Property="BorderBrush" Value="YellowGreen"></Setter>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#FF8B8B8B"/>
    <Setter Property="FontFamily" Value="Verdana"/>
    <Setter Property="FontSize" Value="11px"/>
    <Setter Property="Background" Value="{StaticResource BackGradientBrush}" />
  </Style>

</ResourceDictionary>