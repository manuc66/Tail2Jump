<Window x:Class="Tail2Jump.GUI.CreateEditWatcher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add new Watcher" Height="170" Width="550">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/GeneralDictionary.xaml"></ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="#FF252525">
    <Grid Margin="5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100"></ColumnDefinition>
      <ColumnDefinition Width="*"></ColumnDefinition>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="30"></RowDefinition>
        <RowDefinition Height="30"></RowDefinition>
        <RowDefinition Height="30"></RowDefinition>
        <RowDefinition Height="30"></RowDefinition>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"></ColumnDefinition>
          <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <ComboBox Height="22"  Grid.Column="0" HorizontalAlignment="Stretch" IsEditable="True" IsEnabled="{Binding CanBrowse}" IsTextSearchEnabled="False" ItemsSource="{Binding LocationList}" Style="{StaticResource SMComboBoxStyle}" Text="{Binding Monitoring.FullDirectoryPath, NotifyOnTargetUpdated=True}" />
        <Button Grid.Column="1" Command="{Binding SelectDirectoryCommand}" Content="Browse" Height="22" HorizontalAlignment="Stretch"  Name="btnBrowse" Style="{StaticResource SMButtonStyle}" />
      </Grid>

      <ComboBox Height="22" Margin="0,0,2,0" Grid.Row="1" Grid.Column="1" IsEditable="True" IsEnabled="{Binding CanBrowse}" ItemsSource="{Binding FilterList}" Style="{StaticResource SMComboBoxStyle}" Text="{Binding Monitoring.Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Stretch" />
      <CheckBox Height="16" Grid.Row="2" Grid.Column="1" IsEnabled="{Binding CanChangeRecursive}" IsChecked="{Binding Monitoring.IncludeSubdirectories}" Content="SubDirectories" Foreground="#FFCECECE" Background="#FF706060"  />
      <Grid Grid.Column="1" Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"></ColumnDefinition>
          <ColumnDefinition Width="105"></ColumnDefinition>
          <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="1" Height="22" Content="Cancel" Margin="0,0,5,0" Style="{StaticResource SMButtonStyle}" Command="{Binding CancelCommand}"></Button>
        <Button Grid.Column="2" Height="22" Content="Start" Margin="0,0,0,0" Style="{StaticResource SMButtonStyle}" Command="{Binding StartCommand}"></Button>

      </Grid>

      <TextBlock Grid.Row="0" Height="16" Margin="5,0,5,0" Text="File Path" Style="{StaticResource SMTextBlockStyle}"/>
      <TextBlock Grid.Row="1" Height="16" Margin="5,0,5,0" Text="File / Extension" Style="{StaticResource SMTextBlockStyle}"/>
      <TextBlock Grid.Row="2" Height="16" Margin="5,0,5,0" Text="Portée" Style="{StaticResource SMTextBlockStyle}"/>
    </Grid>
  </Grid>
</Window>
