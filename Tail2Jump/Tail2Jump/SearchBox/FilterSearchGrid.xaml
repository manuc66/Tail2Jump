<UserControl x:Class="Tail2Jump.SearchBox.FilterSearchGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             mc:Ignorable="d" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <LinearGradientBrush x:Key="BackGradientBrush" StartPoint="0,0" EndPoint="0,1" >
                <GradientStop Color="#FF434343" Offset="0.0"/>
                <GradientStop Color="#FF161616" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BorderGradientBrushChecked" StartPoint="0,0" EndPoint="0,1" >
                <GradientStop Color="#FF3DABAB" Offset="0.0"/>
                <GradientStop Color="#FF3DABAB" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GridMonitorElementBackGradientBrush" StartPoint="0,0" EndPoint="0,1" >
                <GradientStop Color="#000000FF" Offset="0.0"/>
                <GradientStop Color="Red" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BackGradientBrushChecked" EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF199393" Offset="0"/>
                <GradientStop Color="#FF1B5252" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BorderBrushRes">
                <GradientStop Color="Gray"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BorderBrushSelectedRes">
                <GradientStop Color="YellowGreen"/>
            </LinearGradientBrush>

            <Style x:Key="ListBoxItemContainerStyle" TargetType="{x:Type ListBoxItem}">
                <Style.Resources>
                    <!--SelectedItem with focus-->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="LightBlue" Opacity="0"/>
                    <!--SelectedItem without focus-->
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="LightBlue" Opacity="0"/>



                    <!--<DataTemplate x:Key="ItemTemplateSelected">
            <Border BorderBrush="{StaticResource BorderBrushSelectedRes}" BorderThickness="2"
              CornerRadius="1" Margin="0,2" Width="126" Height="85">
          
            </Border>
          </DataTemplate>-->

                    <!--<Style TargetType="{x:Type Grid}">
            <Style.Setters>
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    
                  </DataTemplate>
                </Setter.Value>
                
              </Setter>
            </Style.Setters>
          </Style>-->

                </Style.Resources>
                <!-- Set the ItemTemplate of the ListBox to a DataTemplate which
           explains how to display an object of type BitmapImage. -->
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Border CornerRadius="1" Margin="0,2" Width="Auto" Height="20">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushRes}"></Setter>
                                                <Setter Property="BorderThickness" Value="1"></Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSelectedRes}"></Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10"></ColumnDefinition>
                                                <ColumnDefinition Width="60"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.Style>
                                                    <Style TargetType="{x:Type Grid}">
                                                        <Setter Property="Background" Value="DarkGray"></Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.Type}" Value="Valid">
                                                                <Setter Property="Background" Value="YellowGreen"></Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.Type}" Value="Error">
                                                                <Setter Property="Background" Value="Orange"></Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.Type}" Value="Exception">
                                                                <Setter Property="Background" Value="Yellow"></Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.Type}" Value="Critical">
                                                                <Setter Property="Background" Value="Red"></Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            </Grid>
                                            <TextBlock Margin="5,0,0,0" HorizontalAlignment="Center" Foreground="LightGray" Grid.Column="1" Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.DisplayedDatetime}"></TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock Foreground="LightGray" Margin="5,0,0,0" HorizontalAlignment="Center" Grid.Column="1" Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.Text}"></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <!--<Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="ContentTemplate" Value="{StaticResource ItemTemplateSelected}" />
          </Trigger>
        </Style.Triggers>-->
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource BackGradientBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Height="16" Width="16" Source="/GUI/Images/imgMenuSearch_32x32.png"></Image>
            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="2,1,1,2">
                <TextBlock VerticalAlignment="Center" Text="Search: " Foreground="LightGray"></TextBlock>
                <TextBox VerticalAlignment="Center" Text="{Binding TextSearch, UpdateSourceTrigger=PropertyChanged}" Width="175"></TextBox>
                <Button Content="Apply filter" Margin="5,0,0,0" Command="{Binding ApplyFilterCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                            <Setter Property="Visibility" Value="Hidden"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=chkFilter, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IgnoreCase}" Margin="5,0,0,0" Foreground="LightGray" Content="IgnoreCase"></CheckBox>
                <CheckBox VerticalAlignment="Center" x:Name="chkFilter" Margin="5,0,0,0" Foreground="LightGray" Content="Filter">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Unchecked" >
                            <i:InvokeCommandAction Command="{Binding ResetFilterCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </CheckBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
