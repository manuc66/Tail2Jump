<UserControl x:Class="Tail2Jump.MonitoringPanelW8"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Classes\GUI\Styles\GeneralDictionary.xaml"></ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.Resources>
      <BitmapImage x:Key="ImgBack" UriSource="\Classes\GUI\Images/Icons/back.png" />
      <BitmapImage x:Key="ImgNext" UriSource="\Classes\GUI\Images/Icons/next.png" />

      <LinearGradientBrush x:Key="BackGradientBrush" StartPoint="0,0" EndPoint="0,1" >
        <GradientStop Color="#FF434343" Offset="0.0"/>
        <GradientStop Color="#FF161616" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="BorderGradientBrushChecked" StartPoint="0,0" EndPoint="0,1" >
        <GradientStop Color="#FF3DABAB" Offset="0.0"/>
        <GradientStop Color="#FF3DABAB" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="GridMonitorElementBackGradientBrush" StartPoint="0,0" EndPoint="0,1" >
        <GradientStop Color="#000000FF" Offset="0.0"/>
        <GradientStop Color="Red" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="BackGradientBrushChecked" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF199393" Offset="0"/>
        <GradientStop Color="#FF1B5252" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="BorderBrushRes">
        <GradientStop Color="Gray"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="BorderBrushSelectedRes">
        <GradientStop Color="YellowGreen"/>
      </LinearGradientBrush>

      <Style x:Key="ToggleButtonBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushRes}"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ToggleButton}}, Path=IsChecked}" Value="True">
            <Setter Property="Background" Value="{StaticResource BackGradientBrushChecked}"></Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGradientBrushChecked}"></Setter>
            <Setter Property="BorderThickness" Value="2"></Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="ListBoxItemContainerStyle" TargetType="{x:Type ListBoxItem}">
        <Style.Resources>
          <!--SelectedItem with focus-->
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="LightBlue" Opacity="0"/>
          <!--SelectedItem without focus-->
          <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="LightBlue" Opacity="0"/>
        </Style.Resources>
        <!-- Set the ItemTemplate of the ListBox to a DataTemplate which
           explains how to display an object of type BitmapImage. -->
        <Setter Property="ContentTemplate">
          <Setter.Value>
            <DataTemplate>
              <Border Width="121" Height="85">
                <Border.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushRes}"></Setter>
                    <Setter Property="BorderThickness" Value="1"></Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSelectedRes}"></Setter>
                        <Setter Property="BorderThickness" Value="2"></Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="16"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Background="Black" Opacity=".3">
                    <TextBlock Margin="2,0" 
                               HorizontalAlignment="Right" 
                               FontFamily="Segoe WP SemiLight" 
                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" 
                               FontSize="12" 
                               Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.TitleName}">
                    </TextBlock>
                  </Grid>
                  <Grid Grid.Row="1" >
                    <Grid VerticalAlignment="Bottom"  Height="18">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="25"></ColumnDefinition>
                      </Grid.ColumnDefinitions>
                      <Grid Grid.Column="0">
                        <Image Width="16" Height="16" Margin="1">
                          <Image.Style>
                            <Style  TargetType="{x:Type Image}">
                              <Setter Property="Source" Value="{x:Null}"></Setter>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.IsOnScreen}" Value="True">
                                  <Setter Property="Source" Value="\Classes\GUI\Images/imgMonitorBasic_16x16.png"></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.Notified}" Value="True">
                                  <Setter Property="Source" Value="\Classes\GUI\Images/imgNotifBasic_16x16.png"></Setter>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Image.Style>
                        </Image>
                      </Grid>
                      <Grid Grid.Column="2">
                        <Image Width="16" Height="16" Margin="1">
                          <Image.Style>
                            <Style  TargetType="{x:Type Image}">
                              <Setter Property="Source" Value="{x:Null}"></Setter>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.Status}" Value="Started">
                                  <Setter Property="Source" Value="\Classes\GUI\Images/imgPlayBasic_16x16.png"></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=DataContext.Status}" Value="Paused">
                                  <Setter Property="Source" Value="\Classes\GUI\Images\imgPauseBasic_16x16.png"></Setter>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Image.Style>
                        </Image>
                      </Grid>
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </Grid.Resources>
    <Grid Background="{StaticResource GrayOne}"
          Margin="3,3,3,3" Grid.RowSpan="2">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="MonitoringPanelColumn" Width="140"/>
          <ColumnDefinition Width="25"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Vertical" Grid.ColumnSpan="2">
            <TextBlock Foreground="White" Margin="6,0,0,0" FontFamily="Segoe WP SemiLight" Text="Instances" FontSize="22"></TextBlock>
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="White" Margin="6,-2,0,0" FontFamily="Segoe WP SemiLight" Text="Watcher started list" FontSize="12"></TextBlock>
              <TextBlock Foreground="GreenYellow" Margin="6,-2,0,0" FontFamily="Segoe WP SemiLight" Text="{Binding ElementName=m_instanceLst, Path=Items.Count}" FontSize="12"></TextBlock>
            </StackPanel>
          </StackPanel>
          <ListBox Grid.Row="1" Name="m_instanceLst" 
                 SelectionMode="Extended" 
                 SelectionChanged="m_instanceLst_SelectionChanged" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource ListBoxItemContainerStyle}" 
                 ItemsSource="{Binding ListWatcher}" 
                 Background="{x:Null}" 
                 BorderBrush="{x:Null}" 
                 Foreground="#FF424242" Grid.ColumnSpan="2"/>
          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="35"></RowDefinition>
              <RowDefinition Height="27"></RowDefinition>
              <RowDefinition Height="27"></RowDefinition>
              <RowDefinition Height="27"></RowDefinition>
              <RowDefinition Height="27"></RowDefinition>
              <RowDefinition Height="30"></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Foreground="White" Margin="6,0,0,0" FontFamily="Segoe WP SemiLight" Text="Options ..." FontSize="22"></TextBlock>

            <Grid Grid.Row="1" Height="25">
              <Grid Background="{StaticResource GrayTwo}">
                <ToggleButton IsChecked="{Binding MenuSearchIsChecked, Mode=TwoWay}">
                  <ToggleButton.Style>
                    <Style TargetType="{x:Type ToggleButton}">
                      <Setter Property="Background" Value="{StaticResource GrayTwo}"></Setter>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{StaticResource GrayTree}"></Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding MenuSearchIsChecked}" Value="True">
                          <Setter Property="Background" Value="{StaticResource GrayTree}"></Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ToggleButton.Style>
                  <ToggleButton.Content>
                    <Grid>
                      <TextBlock VerticalAlignment="Center" 
                           Foreground="White" 
                           Margin="6,0,0,0" 
                           FontFamily="Segoe WP SemiLight" 
                           Text="Search" 
                           FontSize="12">
                      </TextBlock>
                    </Grid>
                  </ToggleButton.Content>
                </ToggleButton>
              </Grid>
            </Grid>

            <Grid Grid.Row="2"  Height="25">
              <Grid Background="{StaticResource GrayTwo}">
                <TextBlock VerticalAlignment="Center" 
                           Foreground="White" 
                           Margin="6,0,0,0" 
                           FontFamily="Segoe WP SemiLight" 
                           Text="Stress hardware" 
                           FontSize="12">
                </TextBlock>
              </Grid>
            </Grid>

            <Grid Grid.Row="3"  Height="25">
              <Grid Background="{StaticResource GrayTwo}">
                <TextBlock VerticalAlignment="Center" 
                           Foreground="White" 
                           Margin="6,0,0,0" 
                           FontFamily="Segoe WP SemiLight" 
                           Text="Console" 
                           FontSize="12">
                </TextBlock>
              </Grid>
            </Grid>

            <Grid Grid.Row="4"  Height="25">
              <ToggleButton IsChecked="{Binding MenuSearchIsChecked}">
                <ToggleButton.Template>
                  <ControlTemplate>
                    <Grid>
                      <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="False">
                              <Setter Property="Background" Value="{StaticResource GrayTwo}"></Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" Value="{StaticResource GrayTree}"></Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding MenuSearchIsChecked}" Value="True">
                              <Setter Property="Background" Value="{StaticResource GrayTree}"></Setter>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <TextBlock VerticalAlignment="Center" 
                           Foreground="White" 
                           Margin="6,0,0,0" 
                           FontFamily="Segoe WP SemiLight" 
                           Text="Settings" 
                           FontSize="12">
                      </TextBlock>
                    </Grid>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
            </Grid>
          </Grid>
        </Grid>
        <Grid Grid.Column="1" Width="25" HorizontalAlignment="Right" Background="{StaticResource GrayOne}">
          <Grid.RowDefinitions>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
          </Grid.RowDefinitions>
          <Image x:Name="CollapsedImage" Grid.Row="0" Height="20" Width="20" MouseLeftButtonDown="Image_MouseLeftButtonDown_1">
            <Image.Style>
              <Style TargetType="{x:Type Image}">
                <!--<Setter Property="Source" Value="{StaticResource imgBack}"></Setter>-->
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ElementName=MonitoringPanelColumn, Path=Width}" Value="0">
                    <Setter Property="Source" Value="{StaticResource ImgNext}"></Setter>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ElementName=MonitoringPanelColumn, Path=Width}" Value="140">
                    <Setter Property="Source" Value="{StaticResource ImgBack}"></Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Image.Style>
          </Image>
          <Button Grid.Row="1" Command="{Binding StartNewWatcherCommand}">
            <Button.Template>
              <ControlTemplate>
                <Image  Height="20" Width="20" Source="\Classes\GUI\Images/Icons/add.png"></Image>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button Grid.Row="2" Command="{Binding RemoveSelectedWatcherCommand}">
            <Button.Template>
              <ControlTemplate>
                <Image  Height="20" Width="20" Source="\Classes\GUI\Images/Icons/delete.png"></Image>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Grid Grid.Row="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="35"></RowDefinition>
              <RowDefinition Height="27"></RowDefinition>
              <RowDefinition Height="27"></RowDefinition>
              <RowDefinition Height="27"></RowDefinition>
              <RowDefinition Height="27"></RowDefinition>
              <RowDefinition Height="30"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" Width="25" HorizontalAlignment="Right" Height="25" Background="YellowGreen">
              <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding MenuSearchIsChecked}" Value="True">
                      <Setter Property="Background" Value="YellowGreen"></Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Image  Height="20" Width="20" Source="\Classes\GUI\Images\Icons/search.png"></Image>
            </Grid>
            <Grid Grid.Row="2" Width="25" HorizontalAlignment="Right" Height="25" Background="YellowGreen">
              <Image  Height="20" Width="20" Source="\Classes\GUI\Images\Icons\refresh.png"></Image>
            </Grid>
            <Grid Grid.Row="3" Width="25" HorizontalAlignment="Right" Height="25" Background="YellowGreen">
              <Image  Height="20" Width="20" Source="\Classes\GUI\Images\Icons/edit.png"></Image>
            </Grid>
            <Grid Grid.Row="4" Width="25" HorizontalAlignment="Right" Height="25">
              <Image  Height="20" Width="20" Source="\Classes\GUI\Images/Icons/settings.png"></Image>
            </Grid>
          </Grid>
          <Grid.Style>
            <Style TargetType="{x:Type Grid}">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="False">
                  <Setter Property="Opacity" Value="0.6"></Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Opacity" Value="1"></Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

        </Grid>

      </Grid>
      <!--<Grid Grid.Row="1" Margin="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"></ColumnDefinition>
          <ColumnDefinition Width="1*"></ColumnDefinition>
          <ColumnDefinition Width="1*"></ColumnDefinition>
          <ColumnDefinition Width="1*"></ColumnDefinition>
          <ColumnDefinition Width="1*"></ColumnDefinition>
          <ColumnDefinition Width="1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="5" Command="{Binding StartNewWatcherCommand}">
          <Button.Template>
            <ControlTemplate>
              <Image Width="20" Source="Images/Icons/add.png"></Image>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button Grid.Column="0" Command="{Binding RemoveSelectedWatcherCommand}">
          <Button.Template>
            <ControlTemplate>
              <Image Width="20" Source="Images/Icons/cancel.png"></Image>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>-->
    </Grid>
